    <!-- Animation Library -->
    <script src="https://unpkg.com/scrollreveal"></script>
    
    <style>
        :root {
            --bg-pure: #000000;
            --bg-card: #0a0a0a;
            --bg-nav: rgba(0, 0, 0, 0.9);
            --accent: #3b82f6; /* Blue */
            --accent-green: #10b981; /* Emerald */
            --accent-purple: #a855f7; /* Purple */
            --accent-amber: #f59e0b; /* Amber */
            --accent-rose: #f43f5e; /* Rose */
            --accent-cyan: #06b6d4; /* Cyan */
            --accent-indigo: #6366f1; /* Indigo */
            --text-primary: #ffffff;
            --text-secondary: #94a3b8;
            --border: #1a1a1a;
            --transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-pure);
            color: var(--text-primary);
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* --- Navigation --- */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 1.5rem 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--bg-nav);
            backdrop-filter: blur(20px);
            z-index: 1000;
            border-bottom: 1px solid var(--border);
        }

        .logo {
            font-size: 1.25rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: #fff;
            text-decoration: none;
        }
        .logo .highlight-j { color: var(--accent); }
        .logo .dot { color: var(--accent); }

        .nav-links {
            display: flex;
            gap: 2.5rem;
            list-style: none;
        }

        .nav-links a {
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--text-secondary);
            text-decoration: none;
            transition: var(--transition);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .nav-links a:hover { color: var(--accent); }

        /* --- Hero Section --- */
        .hero {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 120px 10% 60px;
        }

        .hero-badge {
            background: rgba(59, 130, 246, 0.1);
            color: var(--accent);
            padding: 0.6rem 1.2rem;
            border-radius: 100px;
            font-weight: 700;
            font-size: 0.75rem;
            letter-spacing: 1.5px;
            margin-bottom: 2rem;
            border: 1px solid rgba(59, 130, 246, 0.2);
        }

        .hero h1 {
            font-size: clamp(2.5rem, 7vw, 5.5rem);
            font-weight: 800;
            line-height: 1.1;
            margin-bottom: 1.5rem;
            letter-spacing: -3px;
        }

        .hero p {
            font-size: 1.2rem;
            color: var(--text-secondary);
            max-width: 750px;
            margin-bottom: 3.5rem;
        }

        /* --- Shared Card Styling --- */
        .card-styled {
            background: var(--bg-card);
            padding: 2.5rem;
            border-radius: 20px;
            border: 1px solid var(--border);
            transition: var(--transition);
            position: relative;
            overflow: hidden;
        }

        .card-styled:hover {
            transform: translateY(-8px);
            background: #0d0d0d;
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }

        /* Border Accent Logic */
        .accent-blue { border-left: 4px solid var(--accent); }
        .accent-green { border-left: 4px solid var(--accent-green); }
        .accent-purple { border-left: 4px solid var(--accent-purple); }
        .accent-amber { border-left: 4px solid var(--accent-amber); }
        .accent-rose { border-left: 4px solid var(--accent-rose); }
        .accent-cyan { border-left: 4px solid var(--accent-cyan); }
        .accent-indigo { border-left: 4px solid var(--accent-indigo); }

        /* --- Sections --- */
        section {
            padding: 100px 8%;
            max-width: 1400px;
            margin: 0 auto;
        }

        .section-header {
            margin-bottom: 4rem;
        }

        .section-header h2 {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 1rem;
            letter-spacing: -1px;
        }

        .section-header .line {
            width: 60px;
            height: 4px;
            background: var(--accent);
            border-radius: 2px;
        }

        /* --- Stats --- */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-top: -100px;
            position: relative;
            z-index: 10;
        }

        .stat-card {
            text-align: center;
        }

        .stat-card h3 {
            font-size: 2.5rem;
            color: #fff;
        }

        .stat-card p {
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--accent);
            text-transform: uppercase;
        }

        /* --- Toolkit --- */
        .grid-3 {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 2rem;
        }

        .toolkit-card h3 {
            margin-bottom: 1.5rem;
            font-size: 1.35rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.6rem;
        }

        .tags span {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border);
            padding: 0.5rem 0.8rem;
            border-radius: 8px;
            font-size: 0.8rem;
            color: var(--text-secondary);
        }

        /* --- Experience --- */
        .job-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 1.5rem;
        }

        .job-date {
            font-size: 0.8rem;
            padding: 0.4rem 1rem;
            border-radius: 100px;
            font-weight: 600;
        }

        .job-desc {
            list-style: none;
            color: var(--text-secondary);
            font-size: 0.95rem;
        }

        .job-desc li {
            margin-bottom: 0.8rem;
            padding-left: 1.2rem;
            position: relative;
        }

        .job-desc li::before {
            content: "→";
            position: absolute;
            left: 0;
            color: var(--accent-indigo);
        }

        /* --- Project Card Extras --- */
        .project-card .type {
            font-size: 0.7rem;
            text-transform: uppercase;
            font-weight: 800;
            margin-bottom: 0.5rem;
            display: block;
        }

        /* --- Footer --- */
        footer {
            background: #050505;
            padding: 80px 8% 40px;
            border-top: 1px solid var(--border);
            text-align: center;
        }

        .btn-main {
            background: var(--accent);
            color: #fff;
            padding: 1rem 2.5rem;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 700;
            transition: var(--transition);
            display: inline-block;
        }

        .social-links {
            display: flex;
            justify-content: center;
            gap: 2rem;
            margin: 3rem 0;
        }

        .social-links a {
            font-size: 1.5rem;
            color: var(--text-secondary);
            transition: 0.3s;
        }

        .social-links a:hover { color: #fff; }

        @media (max-width: 768px) {
            .hero h1 { font-size: 3rem; }
            .stats-grid { margin-top: 0; }
            .grid-3 { grid-template-columns: 1fr; }
            .job-header { flex-direction: column; gap: 1rem; }
        }
    </style>
</head>
